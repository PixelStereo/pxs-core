# Optional native MIDI backend for applications using the portable core.
set(rtmidi_dir "${CMAKE_CURRENT_SOURCE_DIR}/third_party/rtmidi")
if(NOT EXISTS "${rtmidi_dir}/RtMidi.cpp")
    message(FATAL_ERROR "RtMidi is missing: run git submodule update --init --recursive")
endif()

set(rtmidi_source "${rtmidi_dir}/RtMidi.cpp")
if(APPLE)
    set(rtmidi_api __MACOSX_CORE__)
    find_library(core_midi CoreMIDI REQUIRED)
    find_library(core_audio CoreAudio REQUIRED)
    find_library(core_foundation CoreFoundation REQUIRED)
    set(rtmidi_libraries "${core_midi}" "${core_audio}" "${core_foundation}")

    # Remove the exception specification on both declarations and definitions so that
    # a failing MIDIClientCreate can be reported to the caller.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${rtmidi_source}")
    file(READ "${rtmidi_source}" rtmidi_code)
    string(REPLACE "getCoreMidiClientSingleton(const std::string& clientName) throw()"
                   "getCoreMidiClientSingleton(const std::string& clientName)" rtmidi_code "${rtmidi_code}")
    set(rtmidi_source "${CMAKE_CURRENT_BINARY_DIR}/generated/rtmidi/RtMidi.cpp")
    file(CONFIGURE OUTPUT "${rtmidi_source}" CONTENT "@rtmidi_code@" @ONLY)
elseif(WIN32)
    set(rtmidi_api __WINDOWS_MM__)
    set(rtmidi_libraries winmm)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_package(ALSA QUIET)
    if(ALSA_FOUND)
        find_package(Threads REQUIRED)
        set(rtmidi_api __LINUX_ALSA__)
        set(rtmidi_libraries ALSA::ALSA Threads::Threads)
    else()
        message(STATUS "ALSA development headers unavailable: MIDI ports will be disabled")
    endif()
endif()

if(rtmidi_api)
    add_library(pxs_core_rtmidi STATIC "${rtmidi_source}")
    target_include_directories(pxs_core_rtmidi PUBLIC "${rtmidi_dir}")
    target_compile_definitions(pxs_core_rtmidi PRIVATE ${rtmidi_api})
    target_link_libraries(pxs_core_rtmidi PRIVATE ${rtmidi_libraries})
    add_library(pxs-core::rtmidi ALIAS pxs_core_rtmidi)
    set_target_properties(pxs_core_rtmidi PROPERTIES POSITION_INDEPENDENT_CODE ON)
endif()
